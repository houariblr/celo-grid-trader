# ============================================================
#  .env.example — Celo Grid Keeper V2
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env to GitHub.
# ============================================================

# ── Network ──────────────────────────────────────────────────
RPC_URL=https://alfajores-forno.celo-testnet.org
BACKUP_RPC_URLS=https://celo-alfajores.drpc.org,https://alfajores.celo.io
WS_URL=wss://alfajores-forno.celo-testnet.org/ws

# ── Keeper wallet ────────────────────────────────────────────
# Generate a dedicated keeper wallet — do NOT use your main wallet
PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY_HERE
KEEPER_ADDRESS=0xYOUR_KEEPER_PUBLIC_ADDRESS_HERE

# ── Contract ─────────────────────────────────────────────────
CONTRACT_ADDRESS=0xA4d8b9018B18511e5Bbb64d2FEbFCD28537BCe46
CONTRACT_ABI_PATH=../contract/out/GridTrading.sol/GridTradingV2.json

# ── Keeper behaviour ─────────────────────────────────────────
POLL_INTERVAL_MS=5000
SIMULATE_BEFORE_EXECUTE=true
DRY_RUN_MODE=true          # Set to false for real transactions
MIN_PROFIT_THRESHOLD_USD=0.50
MAX_RPC_RETRIES=3

# ── Gas (Celo) ───────────────────────────────────────────────
GAS_LIMIT=300000
USE_LEGACY_TX=false
# Pay gas in cUSD instead of CELO (Celo fee abstraction)
# FEE_CURRENCY_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a

# ── OHLC / price feed ────────────────────────────────────────
OHLC_SYMBOL=CELOUSDT
OHLC_INTERVAL=15m
OHLC_CANDLE_LIMIT=50
OHLC_REFRESH_SECS=900
OHLC_MAX_RETRIES=3

# ── Fallback initial values (used before first OHLC fetch) ───
INITIAL_HIGH=0.70
INITIAL_LOW=0.45

# ── Dashboard WebSocket server ───────────────────────────────
WS_SERVER_BIND_ADDRESS=0.0.0.0:8080

# ── AI Studio (dashboard only) ───────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
