# ================================================================
#  .env.example  –  Celo Grid Trading Keeper V2
#  انسخ هذا الملف إلى .env وعدّل القيم
# ================================================================

# ── إعدادات شبكة Celo ──────────────────────────────────────────
RPC_URL=https://forno.celo.org
WS_URL=wss://forno.celo.org/ws
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=0xYourContractAddressHere
KEEPER_ADDRESS=0xYourKeeperAddressHere

# ── دورة الـ Keeper (بالمللي ثانية) ───────────────────────────
POLL_INTERVAL_MS=5000

# ── إعدادات OHLC الديناميكية (الجديدة في V2) ─────────────────
# رمز الزوج على Binance
OHLC_SYMBOL=CELOUSDT

# الفترة الزمنية للشمعة: 1m | 5m | 15m | 1h | 4h | 1d
OHLC_INTERVAL=15m

# عدد الشموع الأخيرة لحساب القمة والقاع
OHLC_CANDLE_LIMIT=50

# فترة تحديث OHLC بالثواني (900 = 15 دقيقة)
OHLC_REFRESH_SECS=900

# الحد الأقصى لمحاولات إعادة الجلب عند الفشل
OHLC_MAX_RETRIES=3

# ── قيم ابتدائية (تُستخدم حتى أول جلب ناجح) ─────────────────
# عدّلها لتتناسب مع نطاق السعر المتوقع لـ CELO
INITIAL_HIGH=1.00
INITIAL_LOW=0.50

# ── إعدادات الغاز ──────────────────────────────────────────────
GAS_LIMIT=300000

# ── إعدادات ChainClient V2 (Production-Grade) ───────────────────

# مسار ملف ABI للعقد (اختياري - افتراضي: ../contract/out/GridTrading.sol/GridTradingV2.json)
# CONTRACT_ABI_PATH=../contract/out/GridTrading.sol/GridTradingV2.json

# URLs احتياطية للـ RPC (مفصولة بفواصل) - ضرورية لـ Failover
BACKUP_RPC_URLS=https://celo-mainnet-rpc.allthatnode.com,https://rpc.ankr.com/celo

# عنوان عملة رسوم الغاز - cUSD لدفع الرسوم بالدولار المستقر بدلاً من CELO
# Celo Sepolia cUSD: 0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1
# Celo Mainnet cUSD: 0x765DE816845861e75A25fCA122bb6898B8B1282a
FEE_CURRENCY_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a

# تفعيل المحاكاة قبل التنفيذ - يمنع فقدان الغاز في المعاملات الفاشلة
SIMULATE_BEFORE_EXECUTE=true

# الحد الأدنى للربح بالدولار لتبرير تنفيذ الصفقة (يمنع التنفيذ غير المربح)
MIN_PROFIT_THRESHOLD_USD=0.5

# الحد الأقصى لمحاولات إعادة الاتصال بالـ RPC
MAX_RPC_RETRIES=3

# استخدام معاملات Legacy (EIP-155 مُعطل) - اتركه false للـ EIP-1559
USE_LEGACY_TX=false

# وضع المحاكاة فقط (آمن للاختبار - لا يرسل معاملات فعلية)
DRY_RUN_MODE=true

# ── مستوى السجلات: error | warn | info | debug | trace ────────
RUST_LOG=info
